{
  "listen_host": "127.0.0.1",
  "listen_port": 3010,
  "allowed_logins": [
    "REPLACE-with-Craig's-Tailscale-login"
  ],
  "cache_seconds": 15,
  "services": [
    {
      "id": "max",
      "name": "Max (Hermes Agent)",
      "group": "Agents",
      "kind": "systemd",
      "unit": "REPLACE-hermes-unit"
    },
    {
      "id": "paperclip",
      "name": "Paperclip board",
      "group": "Agents",
      "kind": "http",
      "url": "http://127.0.0.1:REPLACE/"
    },
    {
      "id": "broker",
      "name": "Approval broker",
      "group": "Safety",
      "kind": "http",
      "url": "http://127.0.0.1:REPLACE/"
    },
    {
      "id": "kill",
      "name": "Kill switch",
      "group": "Safety",
      "kind": "flag",
      "path": "REPLACE-kill-switch-flag-file",
      "on_text": "agents stopped",
      "off_text": "not pulled",
      "labels": {
        "ok": "Off",
        "down": "On"
      }
    },
    {
      "id": "nutritrace",
      "name": "NutriTrace",
      "group": "Health",
      "kind": "http",
      "url": "http://127.0.0.1:3001/"
    },
    {
      "id": "lifttrace",
      "name": "LiftTrace",
      "group": "Health",
      "kind": "http",
      "url": "http://127.0.0.1:3002/"
    },
    {
      "id": "cooktrace",
      "name": "CookTrace",
      "group": "Health",
      "kind": "http",
      "url": "http://127.0.0.1:3003/"
    },
    {
      "id": "salt",
      "name": "salt.md notes",
      "group": "Notes",
      "kind": "http",
      "url": "http://127.0.0.1:REPLACE/"
    },
    {
      "id": "backup",
      "name": "Nightly backup",
      "group": "Safety",
      "kind": "file_age",
      "dir": "REPLACE-backup-log-dir",
      "glob": "*",
      "max_age_hours": 26
    }
  ],
  "audit_log": "/var/lib/hermes-app/actions.log",
  "paperclip": {
    "url": "http://127.0.0.1:REPLACE",
    "company_id": "REPLACE",
    "key_file": "/etc/hermes-app/paperclip.key",
    "web_url": "https://hermes-oracle.tail4abc29.ts.net:8444"
  },
  "broker": {
    "sqlite_path": "REPLACE-broker-db",
    "pending_sql": "REPLACE: select ... as id, ... as title, ... as recipients, ... as status, ... as requested, ... as expires from ... where pending",
    "history_sql": "REPLACE: same columns plus ... as decided, newest 30",
    "review_url": "https://hermes-oracle.tail4abc29.ts.net/"
  },
  "cost_file": {
    "path": "REPLACE-cost-monitor-json",
    "label": "Max on OpenRouter",
    "fields": {
      "today_usd": "REPLACE",
      "month_usd": "REPLACE",
      "month_cap_usd": "REPLACE",
      "balance_usd": "REPLACE"
    }
  },
  "stop": {
    "request_file": "/var/lib/hermes-app/stop-request"
  }
}