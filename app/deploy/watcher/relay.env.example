CD_URL=http://127.0.0.1:5000
CD_KEY_FILE=/etc/hermes-watch/cd-api.key
MAX_URL=http://127.0.0.1:8642
MAX_KEY_FILE=/etc/hermes-watch/max-api.key
MAX_MODEL=hermes-agent
STATE_DIR=/var/lib/hermes-watch
DAILY_CAP=10
# Fixed-recipient Signal sender (Craig only), shared with the test pack; message arrives on stdin.
NOTIFY_CMD=/usr/local/bin/hermes-notify
