MAX_URL=http://127.0.0.1:8642
MAX_KEY_FILE=/etc/hermes-evals/max-api.key
MAX_MODEL=hermes-agent
# Prints the broker's total request count (e.g. a COUNT over its request log/table).
BROKER_COUNT_CMD=REPLACE
# Runs the broker's own tests verbosely from the copy in /srv/evals/broker
# (e.g. cd /srv/evals/broker && /srv/evals/venv/bin/python -m pytest -v).
BROKER_TEST_CMD=REPLACE
# Max's built-in memory files.
MEMORY_FILES=REPLACE/MEMORY.md,REPLACE/USER.md
# Signal sender with a FIXED recipient (Craig only); message on stdin, no recipient argument.
NOTIFY_CMD=/usr/local/bin/hermes-notify
RESULTS_DIR=/var/lib/hermes-evals
