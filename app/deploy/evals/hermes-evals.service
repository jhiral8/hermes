[Unit]
Description=Hermes regression pack (injection + research cases)
After=network-online.target

# Skipped while the kill switch is on.
ConditionPathExists=!/etc/hermes-paused

[Service]
Type=oneshot
EnvironmentFile=/etc/hermes-evals/evals.env
ExecStart=/usr/bin/python3 -I /srv/evals/run_evals.py --notify
TimeoutStartSec=1800
